  "tasks": [
    {
      "ID": "save-contact",
      "Prompt": "Save a contact named Ada.",
      "Assert": "document.querySelector('#saved').textContent === 'Saved: Ada'",
      "Actions": [
        "document.querySelector('#name').value='Ada'; document.querySelector('#name').dispatchEvent(new Event('input',{bubbles:true})); true",
        "document.querySelector('#contact button').click(); true"
      ]
    },
    {
      "ID": "filter-select",
      "Prompt": "Filter the directory to Grace and select her.",
      "Assert": "document.querySelector('#selected').textContent === 'Selected: Grace' \u0026\u0026 document.querySelector('[data-key=\"Ada\"]').hidden \u0026\u0026 !document.querySelector('[data-key=\"Grace\"]').hidden",
      "Actions": [
        "document.querySelector('#filter').value='Grace'; document.querySelector('#filter').dispatchEvent(new Event('input',{bubbles:true})); true",
        "document.querySelector('[data-person=\"Grace\"]').click(); true"
      ]
    },
    {
      "ID": "open-report",
      "Prompt": "Open the report and find the quarter total.",
      "Assert": "location.hash === '#report' \u0026\u0026 !document.querySelector('#report').hidden \u0026\u0026 document.querySelector('#report').textContent === 'Quarter total: 42'",
      "Actions": [
        "document.querySelector('a').click(); new Promise(resolve =\u003e setTimeout(() =\u003e resolve(true), 20))"
      ]
    }
  ],
