{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sightmap scripted observation smoke results (not model trials)",
  "type": "object",
  "required": [
    "schema_version",
    "execution_kind",
    "run_complete",
    "source_revision",
    "runner_sha256",
    "source_dirty",
    "source_diff_sha256",
    "fixture_sha256",
    "browser",
    "go_version",
    "platform",
    "generated_at",
    "tasks",
    "cells"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "execution_kind": {
      "const": "scripted"
    },
    "run_complete": {
      "type": "boolean"
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "raw-ax",
              "sightmap",
              "sightkick",
              "stagehand-facade"
            ]
          },
          "repetition": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "completed",
              "failed",
              "not_run"
            ]
          },
          "reason": {
            "type": "string"
          },
          "scripted_assertion_success": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "model_tokens": {
            "type": "null"
          },
          "scripted_actions": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "observation_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "wall_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "capture_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "artifact": {
            "type": "string"
          }
        },
        "required": [
          "task",
          "mode",
          "repetition",
          "status",
          "scripted_assertion_success",
          "model_tokens",
          "scripted_actions",
          "observation_bytes",
          "wall_ms",
          "capture_ms"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "not_run"
                }
              }
            },
            "then": {
              "required": [
                "reason"
              ],
              "properties": {
                "scripted_assertion_success": {
                  "type": "null"
                },
                "scripted_actions": {
                  "type": "null"
                },
                "observation_bytes": {
                  "type": "null"
                },
                "wall_ms": {
                  "type": "null"
                },
                "capture_ms": {
                  "type": "null"
                }
              }
            },
            "else": {
              "required": [
                "artifact"
              ],
              "properties": {
                "scripted_assertion_success": {
                  "not": {
                    "type": "null"
                  }
                },
                "scripted_actions": {
                  "not": {
                    "type": "null"
                  }
                },
                "observation_bytes": {
                  "not": {
                    "type": "null"
                  }
                },
                "wall_ms": {
                  "not": {
                    "type": "null"
                  }
                },
                "capture_ms": {
                  "not": {
                    "type": "null"
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "completed"
                }
              }
            },
            "then": {
              "properties": {
                "scripted_assertion_success": {
                  "const": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "failed"
                }
              }
            },
            "then": {
              "properties": {
                "scripted_assertion_success": {
                  "const": false
                }
              }
            }
          }
        ]
      }
    },
    "runner_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_diff_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "source_dirty": {
      "type": "boolean"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "go_version": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "browser": {
      "type": "object"
    },
    "fixture_sha256": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ID",
          "Prompt",
          "Assert",
          "Actions"
        ],
        "properties": {
          "ID": {
            "type": "string",
            "minLength": 1
          },
          "Prompt": {
            "type": "string",
            "minLength": 1
          },
          "Assert": {
            "type": "string",
            "minLength": 1
          },
          "Actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
